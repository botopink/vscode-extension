#!/usr/bin/env bash
# pre-commit — the tracked pre-commit gate of this repository.
#
# Self-contained: it sources scripts/git-hooks/lib/runner-standalone.sh from
# this repository and reaches nothing outside it, so a standalone clone, a
# checkout inside the botopink meta workspace and a worktree all run the same
# gate. Install it once per clone:
#
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail

echo "── pre-commit ──"
# shellcheck source=lib/runner-standalone.sh
. "$(git rev-parse --show-toplevel)/scripts/git-hooks/lib/runner-standalone.sh"
runStandaloneGate
