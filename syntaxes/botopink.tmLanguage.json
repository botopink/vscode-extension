{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Botopink",
  "scopeName": "source.botopink",
  "fileTypes": [
    "bp"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#tuple"
    },
    {
      "include": "#caseGuard"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#enumMember"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#discards"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.module.botopink",
          "match": "////.*$"
        },
        {
          "name": "comment.line.documentation.botopink",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.botopink",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.botopink",
          "match": "\\b(if|else|case|loop|for|break|continue|yield|return|try|catch|throw|await|is)\\b"
        },
        {
          "name": "keyword.declaration.botopink",
          "match": "\\b(fn|val|var|pub|mod|type|behavior|implement|extend|extends|declare|use|from|import|default|test|assert|syntax|comptime|as)\\b"
        },
        {
          "name": "constant.language.botopink",
          "match": "\\b(true|false|null|Self)\\b"
        },
        {
          "comment": "`unknown` is a lexer keyword (`keywordOrIdent`) that reads as a type, so it is pinned in test/lexerKeywords.json and must be highlighted by a rule of this repository — `grammarKeywordRules` reads only `repository.keywords`. The scope is the one `constants` gives every other primitive, so the painting is unchanged: this rule shadows the `support.type.primitive` alternation with the identical name, and both lists stay asserted (the keyword pin here, `registerBuiltins` there).",
          "name": "support.type.primitive.botopink",
          "match": "\\b(unknown)\\b"
        }
      ]
    },
    "caseGuard": {
      "comment": "`when` is not a lexer keyword: it is highlighted only as a case-arm guard — after an arm's pattern (a word, `)`, `]`, `>` or `}`) and before `(`, as in `Option.Some(value: v) when (v is string) { … }`. A `when` identifier elsewhere stays an identifier.",
      "match": "(?<=[\\w)\\]>}])(\\s+)(when)(?=\\s*\\()",
      "captures": {
        "2": {
          "name": "keyword.control.guard.botopink"
        }
      }
    },
    "tuple": {
      "comment": "tuple literal and tuple type `#(…)` — `#(1, \"a\")`, `#(name: string, pop: i32)`; must not be confused with the `#[…]` attribute block. A label of a written tuple type is a name for the compiler (decision 8 §6), so it is scoped as a property; `#parenGroup` keeps a nested `(…)` from closing the tuple early.",
      "begin": "#\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tuple.begin.botopink"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tuple.end.botopink"
        }
      },
      "patterns": [
        {
          "name": "variable.other.property.botopink",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\s*(?=:)"
        },
        {
          "include": "#parenGroup"
        },
        {
          "include": "$self"
        }
      ]
    },
    "parenGroup": {
      "comment": "a bare `(…)` group, so a nested parenthesis inside a `#(…)` tuple does not close it",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "enumMember": {
      "comment": "`.Variant` shorthand — `.Some(v)`, `.None` — when the enum comes from the value's type (a qualified `Option.Some` is coloured by the type rule)",
      "match": "(?<![\\w.])\\.([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.enummember.botopink"
        }
      }
    },
    "attributes": {
      "comment": "attribute blocks: `#[@External.Erlang( \"math\", \"floor\"), …]`",
      "name": "meta.attribute.botopink",
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.botopink"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.botopink"
        }
      },
      "patterns": [
        {
          "name": "entity.name.function.attribute.botopink",
          "match": "@[a-zA-Z_][A-Za-z0-9_]*"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#constants"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "optional chaining — must precede the `?` and `..` rules",
          "name": "keyword.operator.optional-chaining.botopink",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.botopink",
          "match": "->"
        },
        {
          "name": "keyword.operator.pipe.botopink",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.inclusive.botopink",
          "match": "\\.\\.\\.",
          "comment": "`A...B` — an inclusive pattern range, both ends included (decision 8 §5.2). Must precede the `..` rule, which would otherwise take two of the three dots and leave the third unscoped."
        },
        {
          "name": "keyword.operator.range.botopink",
          "match": "\\.\\.",
          "comment": "`..` — a range (`0..n`) and, in a pattern, the rest (`#(0, ..)`, `Shape.Rect(width: w, ..)`)"
        },
        {
          "name": "keyword.operator.comparison.botopink",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.botopink",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.botopink",
          "match": "(<<|>>)"
        },
        {
          "name": "keyword.operator.assignment.botopink",
          "match": "(\\+=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.botopink",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.optional.botopink",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.type.union.botopink",
          "match": "\\|",
          "comment": "`|` — a union type: `i32 | string`, `(i32 | string)[]` (after `||` and `|>`)"
        }
      ]
    },
    "strings": {
      "comment": "Sub-language interiors (erika \"…\" SQL, html \"\"\"…\"\"\" DSL) are NOT scoped here — VSCode is a pure renderer of the LSP's semantic tokens, which override this `string.quoted` scope per-range (editor.semanticHighlighting.enabled is forced on for botopink in package.json). A plain string carries no semantic tokens and stays string-coloured. See modules/vscode-extension/AGENTS.md.",
      "patterns": [
        {
          "name": "string.quoted.triple.botopink",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.botopink",
              "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|[\"\\\\nrt0$])"
            }
          ]
        },
        {
          "name": "string.quoted.double.botopink",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.botopink",
              "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|[\"\\\\nrt0$])"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "comment": "string interpolation hole: `${ … }`",
      "name": "meta.template.expression.botopink",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.botopink"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.botopink"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "include": "#binary_number"
        },
        {
          "include": "#octal_number"
        },
        {
          "include": "#hexadecimal_number"
        },
        {
          "include": "#float_number"
        },
        {
          "include": "#decimal_number"
        },
        {
          "name": "support.type.primitive.botopink",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|string|void|v128|noreturn|unknown)\\b",
          "comment": "the types `Env.registerBuiltins` registers (compiler-core/src/comptime/env.zig), minus `Self` (a constant.language rule of its own), minus `any` \u2014 decision 8 \u00a72.5 gives the user no `any` \u2014 plus `unknown`, decision 8 \u00a72's type, painted ahead of front 06 registering it. `never` was here and is registered nowhere: `fn c(x: never)` is `error: unknown type 'never'`, so the editor was marking a word no program can name as a standard-library type. Pinned by `npm run compiler-check`."
        },
        {
          "name": "entity.name.type.botopink",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "binary_number": {
      "name": "constant.numeric.binary.botopink",
      "match": "\\b0[bB][01_]+\\b"
    },
    "octal_number": {
      "name": "constant.numeric.octal.botopink",
      "match": "\\b0[oO][0-7_]+\\b"
    },
    "hexadecimal_number": {
      "name": "constant.numeric.hexadecimal.botopink",
      "match": "\\b0[xX][0-9a-fA-F_]+\\b"
    },
    "float_number": {
      "name": "constant.numeric.float.botopink",
      "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+\\-]?[0-9_]+)\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
    },
    "decimal_number": {
      "name": "constant.numeric.decimal.botopink",
      "match": "\\b[0-9][0-9_]*\\b"
    },
    "builtins": {
      "patterns": [
        {
          "comment": "builtin `@`-prefixed types — must precede the generic @ident rule",
          "name": "support.type.builtin.botopink",
          "match": "@(Expr|Result|Option|Iterator|Future|AsyncGenerator)\\b"
        },
        {
          "name": "support.function.builtin.botopink",
          "match": "@[a-zA-Z_][A-Za-z0-9_]*"
        }
      ]
    },
    "entity": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.botopink"
            },
            "2": {
              "name": "entity.name.function.botopink"
            }
          }
        },
        {
          "begin": "\\b([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.botopink"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "variable.parameter.botopink",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*:"
        }
      ]
    },
    "discards": {
      "name": "comment.unused.botopink",
      "match": "\\b_(?:[A-Za-z0-9_]+)?\\b"
    }
  }
}
