{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) -> ${3:type} {",
      "\t$0",
      "}"
    ],
    "description": "Private function"
  },
  "Public function": {
    "prefix": "pub fn",
    "body": [
      "pub fn ${1:name}(${2:args}) -> ${3:type} {",
      "\t$0",
      "}"
    ],
    "description": "Public exported function"
  },
  "Value binding": {
    "prefix": "val",
    "body": [
      "val ${1:name} = ${0:value};"
    ],
    "description": "Immutable value binding"
  },
  "Mutable variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0:value};"
    ],
    "description": "Mutable variable binding"
  },
  "Public value": {
    "prefix": "pub val",
    "body": [
      "pub val ${1:NAME} = ${0:value};"
    ],
    "description": "Public exported value"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import { ${1:name} } from \"${2:module}\";"
    ],
    "description": "Named import"
  },
  "Import from std": {
    "prefix": "importstd",
    "body": [
      "import { ${1:list} } from \"std\";"
    ],
    "description": "Import a module from the std package"
  },
  "Test block": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "\tval ${2:got} = $0;",
      "\tassert ${2:got} == ${3:want}, \"${4:why}\";",
      "}"
    ],
    "description": "Test block with an assertion"
  },
  "Assertion": {
    "prefix": "assert",
    "body": [
      "assert ${1:condition}, \"${0:message}\";"
    ],
    "description": "Assertion inside a test block"
  },
  "Iterator function": {
    "prefix": "iterator",
    "body": [
      "#[@iterator]",
      "fn ${1:name}(${2:args}) -> @Iterator<${3:T}> {",
      "\tyield $0;",
      "}"
    ],
    "description": "Iterator function (yields values)"
  },
  "Result function": {
    "prefix": "result",
    "body": [
      "#[@result]",
      "fn ${1:name}(${2:args}) -> @Result<${3:T}, ${4:E}> {",
      "\t$0",
      "}"
    ],
    "description": "Fallible function: #[@result] with its @Result<T, E> return type"
  },
  "External declaration": {
    "prefix": "external",
    "body": [
      "#[@External.Node(\"${1:module}\", \"${2:symbol}\"),",
      "  @External.Erlang(\"${3:module}\", \"${4:symbol}\")]",
      "pub declare fn ${5:name}(${6:args}) -> ${7:type};"
    ],
    "description": "Externally-implemented declare fn with per-target bindings"
  },
  "Type (record)": {
    "prefix": "type",
    "body": [
      "type ${1:Name}(${2:field}: ${3:type}) {",
      "\t$0",
      "}"
    ],
    "description": "Type with fields (record shape)"
  },
  "Type (enum)": {
    "prefix": "typeenum",
    "body": [
      "type ${1:Name} {",
      "\t${2:Variant},",
      "\t$0",
      "}"
    ],
    "description": "Type with variants (enum shape)"
  },
  "Behavior": {
    "prefix": "behavior",
    "body": [
      "behavior ${1:Name} {",
      "\tfn ${2:method}(self: Self)$0",
      "}"
    ],
    "description": "Behavior declaration"
  },
  "Case expression": {
    "prefix": "case",
    "body": [
      "case ${1:subject} {",
      "\t${2:pattern} -> ${3:result};",
      "\t_ -> ${0:fallback};",
      "}"
    ],
    "description": "Pattern matching"
  },
  "If expression": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "Conditional"
  },
  "If-else expression": {
    "prefix": "ifelse",
    "body": [
      "if (${1:cond}) {",
      "\t${2:then}",
      "} else {",
      "\t${0:else}",
      "}"
    ],
    "description": "Conditional with else"
  },
  "Loop over collection": {
    "prefix": "loop",
    "body": [
      "loop (${1:collection}) { ${2:item} ->",
      "\t$0",
      "};"
    ],
    "description": "Loop over a collection"
  },
  "Loop with break value": {
    "prefix": "loopmap",
    "body": [
      "val ${1:result} = loop (${2:collection}) { ${3:item} ->",
      "\tbreak ${0:value};",
      "};"
    ],
    "description": "Map via loop + break"
  },
  "Comptime expression": {
    "prefix": "comptime",
    "body": [
      "comptime ${0:expr}"
    ],
    "description": "Compile-time evaluation"
  },
  "Try with catch": {
    "prefix": "trycatch",
    "body": [
      "val ${1:r} = try ${2:expr} catch ${0:fallback};"
    ],
    "description": "Error handling with fallback"
  },
  "Implement for record": {
    "prefix": "implement",
    "body": [
      "val ${1:Name} = implement ${2:Interface} for ${3:Type} {",
      "\tfn ${4:method}(self: Self) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implement an interface for a type"
  }
}
